{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vnu-jar": "^26.7.22"
  },
  "scripts": {
    "dev": "tailwindcss -i ./css/input.css -o ./dist/output.css --watch",
    "build": "tailwindcss -i ./css/input.css -o ./dist/output.css --minify",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:html": "vnu-jar index.html"
  }
}
